<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scans the watch directories every 15 minutes for a dropped export zip.
  Replace __HOME__ with your home directory (launchd does not expand ~), then:

    cp com.synchealth.watch.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.synchealth.watch.plist

  RunAtLoad is false on purpose: loading the job should not kick off an import
  of whatever happens to be sitting in ~/Downloads at that moment.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.synchealth.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.local/bin/synchealth-watch</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__HOME__/.synchealth/watch.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.synchealth/watch.err</string>
</dict>
</plist>
